{
  "name": "lektor",
  "version": "1.0.9",
  "private": true,
  "description": "Lector de encuestas: PDF escaneado a datos, con revisión de marcas dudosas.",
  "author": "fortasec53-design",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never",
    "ocr:probar": "node scripts/probar-ocr.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pdf-lib": "^1.17.1",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "design.fortasec.lektor",
    "productName": "Lector de encuestas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!samples/**",
      "!docs/**",
      "!scripts/**",
      "!src/**",
      "!**/*.{md,markdown}",
      "!**/{test,tests,__tests__}/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/scripts/**",
      "!node_modules/**/*.{md,markdown}"
    ],
    "extraResources": [
      {
        "from": "public/tessdata",
        "to": "tessdata"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lector-de-encuestas-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fortasec53-design",
        "repo": "lektor"
      }
    ]
  }
}
